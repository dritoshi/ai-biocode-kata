# ~/.ssh/config の設定例
# このファイルを ~/.ssh/config にコピーまたは追記して使用する

# 踏み台サーバ
Host bastion
    HostName gateway.example.ac.jp
    User your_username
    IdentityFile ~/.ssh/id_ed25519

# HPC（踏み台経由で自動接続）
Host hpc
    HostName login.hpc.internal
    User your_username
    IdentityFile ~/.ssh/id_ed25519
    ProxyJump bastion
    ServerAliveInterval 60
